                "hash": {
                    "url": "https://update.code.visualstudio.com/api/versions/$version/darwin-arm64/stable",
                    "jsonpath": "$.sha256hash"
                }
            },
            "x86_64": {
                "url": "https://update.code.visualstudio.com/$version/darwin/stable#/VSCode-darwin.zip",
                "hash": {
                    "url": "https://update.code.visualstudio.com/api/versions/$version/darwin/stable",
                    "jsonpath": "$.sha256hash"
                }
            }
        }
    }
