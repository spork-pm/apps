    "architecture": {
        "arm64": {
            "url": "https://update.code.visualstudio.com/0/darwin-arm64/stable#/VSCode-darwin-arm64.zip"
        },
        "x86_64": {
            "url": "https://update.code.visualstudio.com/0/darwin/stable#/VSCode-darwin.zip"
