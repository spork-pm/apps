{
    "version": "0",
    "description": "Free and open-source web browser from Mozilla",
    "homepage": "https://www.mozilla.org/firefox/",
    "license": "MPL-2.0",
    "url": "https://download-installer.cdn.mozilla.net/pub/firefox/releases/0/mac/en-US/Firefox%200.dmg",
    "app": "Firefox.app",
    "notes": "This is the US English build. Firefox updates itself in ~/Applications.",
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_VERSION"
    },
    "autoupdate": {
        "url": "https://download-installer.cdn.mozilla.net/pub/firefox/releases/$version/mac/en-US/Firefox%20$version.dmg",
        "hash": {
            "url": "https://download-installer.cdn.mozilla.net/pub/firefox/releases/$version/SHA256SUMS",
            "regex": "^([0-9a-f]{64})  mac/en-US/Firefox $version\\.dmg$"
        }
    }
}
